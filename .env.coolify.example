# Salin ke Coolify → Environment Variables (Docker Compose).
# App saja — Postgres & MinIO sudah jalan di server terpisah.
# Jangan commit nilai asli ke git.
#
# Hostname harus bisa dijangkau dari container app
# (nama service Coolify di jaringan yang sama, atau IP/host LAN).
# Karakter khusus di password DATABASE_URL harus di-URL-encode
# (@ → %40, # → %23, / → %2F).

# --- Wajib ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/numa3d

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=

MINIO_ENDPOINT=minio.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=numa3d-files
