# Salin ke Coolify → Environment Variables (Docker Compose).
# App saja — Postgres & MinIO sudah jalan di server terpisah.
# Jangan commit nilai asli ke git.
#
# Hostname Coolify (UUID seperti m2a81yq3ad7hvelheztfqywy) hanya
# resolve jika app dan Postgres/MinIO di jaringan Docker yang sama.
# Di resource app Coolify: General → Connect to Predefined Network → on,
# lalu redeploy. Atau di Postgres: Networks → sambungkan ke jaringan app.
# Karakter khusus di password DATABASE_URL harus di-URL-encode
# (@ → %40, # → %23, / → %2F).

# --- Wajib ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/numa3d

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=

MINIO_ENDPOINT=minio.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=numa3d-files
